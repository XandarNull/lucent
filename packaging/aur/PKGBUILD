# Maintainer: Xandar Null <https://github.com/your-username>
pkgname=lucent-theme-git
pkgver=1.0.r0.g$(date +%Y%m%d)
pkgrel=1
pkgdesc="Standalone unified translucent theme suite with native C++ style and window decoration for KDE Plasma 6"
arch=('x86_64')
url="https://github.com/your-username/lucent-darkly"
license=('GPL-3.0-or-later')
depends=(
    'plasma-workspace>=6.0'
    'kcolorscheme'
    'kdecoration'
    'kconfig'
    'kconfigwidgets'
    'kguiaddons'
    'ki18n'
    'kiconthemes'
    'kwindowsystem'
    'qt6-base'
    'qt6-declarative'
)
makedepends=('git' 'cmake' 'extra-cmake-modules' 'ninja')
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf "1.0.r%s.%s" "$(git rev-list --count HEAD 2>/dev/null || echo 0)" "$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
}

build() {
    cmake -B build -S "${srcdir}/${pkgname}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -GNinja
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build

    # Install Lucent default configuration to doc / skel
    install -Dm644 "${srcdir}/${pkgname}/config/lucentrc" "${pkgdir}/etc/skel/.config/lucentrc"
    install -Dm644 "${srcdir}/${pkgname}/config/lucentrc" "${pkgdir}/usr/share/doc/${pkgname}/lucentrc"
    install -Dm644 "${srcdir}/${pkgname}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "${srcdir}/${pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
